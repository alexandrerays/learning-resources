   RowBox[{"[", 
    RowBox[{";;", "4"}], "]"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.688719611872751*^9, 3.6887196388539143`*^9}, {
  3.688719682931911*^9, 3.6887196945157137`*^9}, {3.6887198596306562`*^9, 
  3.688719860278084*^9}}],

Cell[CellGroupData[{

Cell[BoxData["%8"], "Input",
 NumberMarks->False],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"The Moon is Earth's only permanent natural satellite.\"\>", 
   ",", "\<\"It is the fifth-largest natural satellite in the Solar System, \
and the largest among planetary satellites relative to the size of the planet \
that it orbits (its primary).\"\>", 
   ",", "\<\"It is the second-densest satellite among those whose densities \
are known (after Jupiter's satellite Io).\"\>", 
   ",", "\<\"The average distance of the Moon from the Earth is 384,400 km \
(238,900 mi), or 1.28 light-seconds.\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.688719875604835*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData["%6"], "Input",
 NumberMarks->False],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"The Moon is Earth's only permanent natural satellite.\"\>", 
   ",", "\<\"It is the fifth-largest natural satellite in the Solar System, \
and the largest among planetary satellites relative to the size of the planet \
that it orbits (its primary).\"\>", 
   ",", "\<\"It is the second-densest satellite among those whose densities \
are known (after Jupiter's satellite Io).\"\>", 
   ",", "\<\"The average distance of the Moon from the Earth is 384,400 km \
(238,900 mi), or 1.28 light-seconds.\"\>", 
   ",", "\<\"The Moon is thought to have formed about 4.5 billion years ago, \
not long after Earth.\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.688719718272572*^9}]
}, Open  ]],

